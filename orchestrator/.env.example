# How Slack / humans reach this service (must be internet-reachable if using real Datadog + Slack)
PUBLIC_BASE_URL=http://localhost:8080

# Same Postgres as the app, different table
DATABASE_URL=postgresql://flashsale:flashsale@localhost:5432/flashsale

# Shared secret checked against the Datadog webhook's custom header
DATADOG_WEBHOOK_TOKEN=change-me

# TrueForge harness — TODO confirm real values against TrueForge docs
# TrueFoundry control-plane base URL (no trailing slash)
TRUEFORGE_API_URL=https://your-control-plane.truefoundry.cloud
TRUEFORGE_API_KEY=
TRUEFORGE_AGENT_ID=your-agent-app-id
TRUEFORGE_ITERATION_LIMIT=15

# Legacy only: leave blank when MCP servers are attached to the Agent App.
MCP_DIAGNOSTICS_URL=
MCP_ACTIONS_URL=
MCP_SLACK_URL=

# Working today without TrueForge's Slack MCP: a plain Incoming Webhook URL
SLACK_WEBHOOK_URL=

# service -> Slack user ID to tag, as JSON
OWNER_MAP={"flashsale-app": "U0000000000"}
DEFAULT_OWNER_SLACK_ID=U0000000000
