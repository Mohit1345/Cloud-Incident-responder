# Orchestrator this server checks approval status against — never bypass this
ORCHESTRATOR_URL=http://localhost:8080

DATABASE_URL=postgresql://flashsale:flashsale@localhost:5432/flashsale
REDIS_URL=redis://localhost:6379/0

# Whitelisted path to app/products.py as seen from INSIDE this container.
# Mount the app's source dir read-write for this one file to work.
APP_PRODUCTS_PATH=/host-app/app/products.py

# Bundled inside the image at build time — do not point this at agent input.
FIXED_PATCH_PATH=/app/patches/products_fixed.py

# Container name to restart after patching (must match docker-compose service)
APP_CONTAINER=cloud-incident-responder-app-1
