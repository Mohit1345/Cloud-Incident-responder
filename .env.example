# Sandbox mode — mock AWS/observability/deployments (default: true)
SANDBOX=true

# Use real Slack via Forage MCP server (default: true)
# When true: posts to Slack using SLACK_BOT_TOKEN or SLACK_WEBHOOK_URL
# When false: prints resolution to console only
USE_FORAGE_SLACK=true

# Slack credentials (required when USE_FORAGE_SLACK=true)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#incidents
# Or use incoming webhook instead of bot token:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

LOG_LEVEL=INFO
