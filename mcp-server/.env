# App endpoint (running locally or in Docker)
APP_URL=http://localhost:8000

# Redis connection
REDIS_URL=redis://localhost:6379/0

# PostgreSQL connection (forwarded from Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=flashsale
DB_PASSWORD=flashsale
DB_NAME=flashsale

# Docker container name for log tailing (used by get_app_logs tool)
# This tool calls docker logs via subprocess — requires Docker CLI access.
# If running the MCP server inside Docker, mount the Docker socket:
#   volumes:
#     - /var/run/docker.sock:/var/run/docker.sock
APP_CONTAINER=cloud-incident-responder-app-1
DB_CONTAINER=cloud-incident-responder-postgres-1

# Optional: local log file path for get_app_logs_from_file
# Use this when Docker access is unavailable (e.g., MCP server in WSL2
# cannot reach Docker Desktop's Linux engine on Windows host).
LOG_FILE_PATH=
